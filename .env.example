# Generate each secret yourself. Never commit a populated .env.
AGENT_API_TOKEN=
PUBLIC_ORIGIN=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=
MODELO=gemini-3.5-flash-lite
FALLBACK_MODEL=gemini-3.5-flash
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
PORT=8000
DATABASE_URL=
WEBUI_SECRET_KEY=
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=
WEBUI_AUTH=true
ENABLE_SIGNUP=false
ENABLE_OPENAI_API=false
ENABLE_OLLAMA_API=false

# Exact upstream slim runtime branch; set by supervisor as well.
USE_SLIM_DOCKER=true
OFFLINE_MODE=true
HF_HUB_OFFLINE=1
